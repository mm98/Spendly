# Only what a stage of the Dockerfile copies is sent to the build. Release notes and the version
# are worked out on the runner before the build and reach the image as build arguments.
*
!api
!react
!storybook

**/node_modules
**/.gitignore
**/*.md
react/dist
storybook/dist
api/.models

# A database run from api/ keeps its key, saved files and backups beside it.
api/*.sqlite3*
api/secret.key
api/storage
api/backup

# Checks and tests. api/scripts stays: fetch-model.mjs is run by the build, the rest inside a
# running container. react/scripts/precompress.mjs runs after the app build.
api/test
api/query-plans.json
api/scripts/check-queries.mjs
react/scripts
!react/scripts/precompress.mjs
storybook/tests
storybook/scripts
