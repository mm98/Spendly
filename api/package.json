{
	"name": "spendly-api",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"description": "Spendly's real API: an Express server over a SQLite database, replacing the phantom in-memory store react/src/api/client.js used to wrap.",
	"scripts": {
		"dev": "node --watch src/server.js",
		"start": "node src/server.js",
		"test": "node --test test/*.test.js",
		"queries:check": "node scripts/check-queries.mjs",
		"queries:bless": "node scripts/check-queries.mjs --update",
		"backup": "node scripts/backup-db.mjs"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.117.1",
		"@huggingface/transformers": "^4.3.1",
		"@simplewebauthn/server": "^14.0.3",
		"better-sqlite3": "^13.0.3",
		"compression": "^1.8.2",
		"express": "5.1.0",
		"multer": "^2.2.0",
		"mupdf": "^1.28.0",
		"nodemailer": "^10.0.16",
		"sharp": "^0.35.3"
	},
	"allowScripts": {
		"better-sqlite3": true,
		"onnxruntime-node": false,
		"protobufjs": false
	}
}
