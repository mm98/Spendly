<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS 404s any extension with no MIME mapping, and none of these three had ever been
     requested as a file before: the fonts used to be base64 text inside app.css, and the
     manifest is rare enough that a default IIS install has no entry for it either. Nothing
     else here needs a mapping -- .css, .js, .svg, .png and .ico are all built in. -->
<configuration>
	<system.webServer>
		<staticContent>
			<remove fileExtension=".woff2" />
			<mimeMap fileExtension=".woff2" mimeType="font/woff2" />
			<remove fileExtension=".woff" />
			<mimeMap fileExtension=".woff" mimeType="font/woff" />
			<remove fileExtension=".webmanifest" />
			<mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
		</staticContent>
	</system.webServer>
</configuration>
