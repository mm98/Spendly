<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<system.webServer>
		<httpProtocol>
			<!-- Cross-Origin-Opener-Policy hardened to same-origin-allow-popups (cross-window isolation).
			     SAFE for social login because the OAuth popup callback is served from the physical
			     /oauth-callback/ folder, whose own web.config sets unsafe-none — so window.opener survives
			     there. Set EXPLICITLY (remove + add) so the value is deterministic regardless of inherited
			     parent COOP. Do NOT relax this to unsafe-none, and do NOT go stricter to same-origin (the
			     login page must be allowed to retain the popup it opens). See public/oauth-callback/web.config
			     and docs/OAUTH-GOOGLE-POPUP-COOP.md. -->
			<customHeaders>
				<remove name="Cross-Origin-Opener-Policy" />
				<add name="Cross-Origin-Opener-Policy" value="same-origin-allow-popups" />
				<!-- Baseline security headers (remove + add = deterministic regardless of inherited config). -->
				<remove name="X-Content-Type-Options" />
				<add name="X-Content-Type-Options" value="nosniff" />
				<remove name="Referrer-Policy" />
				<add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
				<remove name="X-Frame-Options" />
				<add name="X-Frame-Options" value="SAMEORIGIN" />
				<remove name="Strict-Transport-Security" />
				<add name="Strict-Transport-Security" value="max-age=31536000" />
			</customHeaders>
		</httpProtocol>
		<rewrite>
			<rules>
				<rule name="React Routes" stopProcessing="true">
					<match url=".*" />
					<conditions logicalGrouping="MatchAll">
						<add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
						<add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
						<add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
					</conditions>
					<action type="Rewrite" url="/index.html" />
				</rule>
			</rules>
			<outboundRules>
				<rule name="Change Server header">
					<match serverVariable="RESPONSE_Server" pattern=".+" />
					<action type="Rewrite" value="Kitchen Coffee machine" />
				</rule>
			</outboundRules>
		</rewrite>
		<staticContent>
			<mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
			<!-- Added for the three Poppins faces: they used to be base64 text inside app.css, so no
			     .woff2 file was ever requested on its own, and IIS 404s any extension it has no mapping
			     for. remove + add because .woff2/.woff are commonly pre-mapped at the applicationHost.config
			     level on modern IIS, where a mimeMap with no remove first throws 500.19 (duplicate
			     section). Note: XML comments cannot contain a double hyphen, unlike the CSS and JS ones
			     elsewhere in this repo. -->
			<remove fileExtension=".woff2" />
			<mimeMap fileExtension=".woff2" mimeType="font/woff2" />
			<remove fileExtension=".woff" />
			<mimeMap fileExtension=".woff" mimeType="font/woff" />
		</staticContent>
	</system.webServer>
	<!-- index.html and version.json must always be revalidated (no-cache) so a new deploy is
	     picked up: the freshly-hashed asset URLs in index.html and the new build id in
	     version.json are never served stale. The content-hashed /assets/* files are immutable for
	     a year (their hash changes whenever their content does). If clientCache is locked at the
	     IIS server level these overrides throw HTTP 500.19 — unlock it via appcmd. -->
	<location path="index.html">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="DisableCache" />
			</staticContent>
		</system.webServer>
	</location>

	<location path="version.json">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="DisableCache" />
			</staticContent>
		</system.webServer>
	</location>

	<location path="assets">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="immutable" />
			</staticContent>
		</system.webServer>
	</location>
</configuration>
